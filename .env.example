# Template — copy to .env.production (or .env) and fill in. Never commit real values.
# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# Frontend URL allowed by CORS
CLIENT_ORIGIN=https://your-frontend-domain
# Public URL of this backend — used to build unsubscribe links inside emails
PUBLIC_BASE_URL=https://your-api-domain

# ─── Database / Queue ────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/vitalbase_marketing


#### Redis Conf ####
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Lead discovery ──────────────────────────────────────
# Optional. Without it only the free OpenStreetMap source is available.
# Set a daily quota cap in Google Cloud Console so you never get billed.
GOOGLE_PLACES_API_KEY=
# Identifies our crawler to websites and to OpenStreetMap (put a real contact email)
CRAWLER_USER_AGENT=LeadFinderBot/0.1 (contact: marketing@your-company-domain)

# ─── AI (Claude) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ─── Email sending — Gmail via Nodemailer ───────────────
# SMTP_USER  = your full Gmail address
# SMTP_PASS  = a 16-character Google *App Password* (not your normal password):
#              Google Account → Security → 2-Step Verification (must be on) → App passwords
# MAIL_FROM_EMAIL should be the same Gmail address (Gmail replaces any other From address)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Your Company Team
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=

# true = emails are logged, not actually sent (keep true until SMTP + domain are ready)
EMAIL_DRY_RUN=false
EMAIL_DAILY_LIMIT=40
EMAIL_PER_MINUTE=2

# Random long string — signs unsubscribe links
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string
