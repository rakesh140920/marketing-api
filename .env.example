# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Frontend URL allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
# Public URL of this backend — used to build unsubscribe links inside emails
PUBLIC_BASE_URL=http://localhost:5000

# ─── Database / Queue ────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/vitalbase_marketing
REDIS_URL=redis://127.0.0.1:6379

# ─── Lead discovery ──────────────────────────────────────
# Optional. Without it only the free OpenStreetMap source is available.
# Set a daily quota cap in Google Cloud Console so you never get billed.
GOOGLE_PLACES_API_KEY=AIzaSyAAY29OWtdr6fO4_EmLdEQEb_S3SCrcsjs
# Identifies our crawler to websites and OpenStreetMap. Put a real contact email here —
# OpenStreetMap blocks placeholder addresses like example.com (HTTP 403).
CRAWLER_USER_AGENT=VitalBaseLeadBot/0.1 (contact: marketing@your-company-domain)

# ─── AI (Claude) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ─── Email sending (any SMTP: Gmail app password, Brevo, Amazon SES, Zoho…) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=VitalBase Team
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=

# true = emails are logged, not actually sent (keep true until SMTP + domain are ready)
EMAIL_DRY_RUN=true
EMAIL_DAILY_LIMIT=40
EMAIL_PER_MINUTE=2

# Random long string — signs unsubscribe links
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string
